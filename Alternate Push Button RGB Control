// the goal of this program is to have the pushbutton control the rgb. when pressed the Red and Blue lights should be on, and when not pressed the red and green lights should be on
//the main theme is digital input controlling digital output
void setup() { // A one-use block of code. It initializes the sketch and allows the structure of the code or the arduino itself to be written.
 Serial.begin(9600); // Tells the program to start the serial communication at 9600 bits per second

 pinMode(2, INPUT_PULLUP); //sets pin #2 as an input using the internal pull up resistor
  pinMode(R, OUTPUT); // sets pin #13 (Red) as an output
  pinMode(B, OUTPUT); // sets pin #12 (Blue) as an output
  pinMode(G, OUTPUT); // sets pin #11 (Green) as an output
}
void loop() { // This is another one-use line. This determines what the code actually does, and in this case, it will continously loop the code.

  int buttonState = digitalRead(2); //creates a variable for what reading of pin #2 named "buttonState"
  
  Serial.print("buttonState = "); //prints exactly what is in the quotations into the serial monitor
  Serial.print("\t"); //creates a space on the line in the serial monitor
  Serial.println(buttonState); //prints the value read from pin #2 on the same line as the previous commands onto the serial monitor
  delay(100); //delays the printing of a new line by 100 milliseconds
int R = 13; //creates a variable for pin #13 named "R"
 int B = 12; // creates a variable for pin #12 named "B"
 int G = 11; // creates a variable for pin #11 named "G"

 digitalWrite(R, 1); //tells pin #13 to be constantly at max power
 digitalWrite(B, !buttonState); //tells pin #12 to react to the opposite value of the pushbutton
 digitalWrite(G, buttonState); //tells pin #11 to react to the value of the pushbutton

}
