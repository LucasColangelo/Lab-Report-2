// The goal of this program is to have the LEDs chase eachother. Basically having one turn on, then the next one, then the next one in a sequential way. 
// The main theme of this program is Digital Output.


void setup() { // A one-use block of code. It initializes the sketch and allows the structure of the code or the arduino itself to be written.
  
  pinMode(13, OUTPUT); // this sets pin #13 to be an OUTPUT pin.
  pinMode(12, OUTPUT); // this sets pin #12 to be an OUTPUT pin
  pinMode(11, OUTPUT); //this sets pin #11 to be an OUTPUT pin
  pinMode(10, OUTPUT); // this sets pin #10 to be an output pin
}


void loop() { // This is another one-use line. This determines what the code actually does, and in this case, it will continously loop the code.
  digitalWrite(13, 1); // this tells pin #13 to output at max power
  digitalWrite(12, 0); // this tells pin #12 to stay at Low power
  digitalWrite(11, 0); // this tells pin #11 to stay at low power 
  digitalWrite(10, 0);
  delay(1000); // this delays the program by 1000 milliseconds before starting the next lines
  digitalWrite(13, 0); //this tells pin #13 to return to low power
  digitalWrite(12, 1); // this tells pin #12 to output max power
  digitalWrite(11, 0); // this tells pin #11 to stay at low power
  digitalWrite(10, 0);
